{
    "KPackageStructure": "Plasma/Applet",
    "KPlugin": {
        "Authors": [
            {
                "Name": "N0repi"
            }
        ],
        "Category": "Date and Time",
        "Description": "Compact panel clock with configurable order for time, day, and date on one line",
        "Icon": "/icon.png",
        "Id": "com.github.N0repi.compactclock",
        "License": "GPL-3.0-or-later",
        "Name": "Compact Clock",
        "Version": "0.1.0",
        "Website": "https://github.com/N0repi/kde-compact-clock"
    },
    "X-Plasma-API": "declarativeappletscript",
    "X-Plasma-API-Minimum-Version": "6.0",
    "X-Plasma-MainScript": "ui/main.qml",
    "X-Plasma-Provides": [
        "org.kde.plasma.time",
        "org.kde.plasma.date"
    ]
}
